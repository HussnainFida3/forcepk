# Copy to .env on the VPS. NEVER commit the real file (.env* is gitignored).
# On the live server this file already exists at /var/www/forcepk/.env (chmod 600);
# deploys never overwrite it. This template lists every key + where its value comes from.

# ── Database (required) — Prisma connection string ──
# Live VPS: a local PostgreSQL DB. Format:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL=postgresql://forcepk:CHANGE_ME_long_random@localhost:5432/forcepk?schema=public
# Only if you use the bundled Postgres container (docker-compose.prod.yml):
POSTGRES_USER=forcepk
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=forcepk

# ── App (required) ──
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_long_random
NEXTAUTH_URL=https://forcepk.com
AUTH_TRUST_HOST=true
# Port Next.js binds to (nginx proxies forcepk.com -> 127.0.0.1:3005)
PORT=3005

# ── Public ──
NEXT_PUBLIC_WHATSAPP_NUMBER=+10000000000

# ── Optional integrations (leave blank to keep disabled) ──
RESEND_API_KEY=
EMAIL_FROM=ForcePK <noreply@forcepk.com>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# AI — OpenAI is primary; Anthropic optional fallback (either enables AI features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
STRIPE_SECRET_KEY=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
# Google sign-in (optional) — from console.cloud.google.com OAuth credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Super admin bootstrap (used once, by scripts/bootstrap-admin.ts) ──
ADMIN_EMAIL=owner@forcepk.com
ADMIN_PASSWORD=CHANGE_ME_min_8_chars
ADMIN_NAME=ForcePK Owner
