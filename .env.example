# ─── Core (required) ───────────────────────────────────────────────
# PostgreSQL connection string (embedded DB default shown)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/forcepk?schema=public"
# Auth.js secret — generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Public WhatsApp contact number for the floating button (international format)
NEXT_PUBLIC_WHATSAPP_NUMBER="+10000000000"

# ─── External integrations (optional) ──────────────────────────────
# Every integration is OPTIONAL. The platform runs fully without them
# (safe stubs). Add a key and restart — the feature activates instantly.
# Status is visible at /admin/integrations.

# Email (Resend) — transactional email
RESEND_API_KEY=""
EMAIL_FROM="ForcePK <noreply@forcepk.com>"

# WhatsApp Business (Meta Cloud API)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# AI (Anthropic) — CV parsing, matching, admin assistant
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
ANTHROPIC_AGENT_MODEL="claude-opus-5-5"

# Google Sign-In (OAuth) — the "Continue with Google" button appears when set.
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Object storage (S3) — secure documents (falls back to local disk)
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"

# Media uploads (Cloudinary) — images & logos (falls back to local /public/uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payments (Stripe)
STRIPE_SECRET_KEY=""

# Video interviews (Zoom Server-to-Server OAuth)
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# E-signature (DocuSign)
DOCUSIGN_INTEGRATION_KEY=""
DOCUSIGN_ACCOUNT_ID=""

# Government platforms (Qiwa / Musaned) — requires official authorization
QIWA_API_KEY=""
